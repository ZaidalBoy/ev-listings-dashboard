# Auto.dev Free Tier API Key (1,000 calls/month, 5 req/sec)
# Leave empty to run in Demo Seed Mode (0 API calls)
AUTODEV_API_KEY=

# Server port (3001 in dev with Vite proxy; 3000 in production)
PORT=3001

# Optional: Monthly quota hard ceiling & reserve (defaults shown)
MONTHLY_CALL_CAP=1000
QUOTA_RESERVE_BUFFER=50
DAILY_SYNC_MAX_CALLS=5
SYNC_INTERVAL_HOURS=24
