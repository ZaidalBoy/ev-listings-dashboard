{
  "name": "ev-listings-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "EV Listings Dashboard (v1) built for Auto.dev Free Tier with strict 1,000 API calls/month preservation",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "sync:daily": "node server/cli-sync.js",
    "export:static": "node server/export-static.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
